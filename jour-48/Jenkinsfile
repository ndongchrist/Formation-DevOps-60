pipeline {
  agent any

  environment {
    AWS_DEFAULT_REGION = 'eu-west-3'
    PROJECT_DIR        = 'jour-48'   // the folder of the project in the repo
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Installation') {
      steps {
        dir("${env.PROJECT_DIR}/app") { sh 'npm ci' }
      }
    }

    stage('Tests') {
      steps {
        dir("${env.PROJECT_DIR}/app") {
          sh 'npx vitest run --reporter=default --reporter=junit --outputFile.junit=test-results.xml'
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: "${env.PROJECT_DIR}/app/test-results.xml"
        }
      }
    }

    stage('Build React') {
      steps {
        dir("${env.PROJECT_DIR}/app") {
          sh '''
            export VITE_BUILD_NUMBER="$BUILD_NUMBER"
            export VITE_GIT_COMMIT="$(echo "$GIT_COMMIT" | cut -c1-7)"
            export VITE_BUILD_DATE="$(date '+%d/%m/%Y %H:%M')"
            npm run build
          '''
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        dir("${env.PROJECT_DIR}/infra") {
          sh 'terraform init -input=false'
          sh 'terraform plan -out=tfplan -input=false'
        }
      }
    }

    stage('Validation') {
      steps { input message: 'Appliquer les changements Terraform ?' }
    }

    stage('Terraform Apply') {
      steps {
        dir("${env.PROJECT_DIR}/infra") { sh 'terraform apply -input=false tfplan' }
      }
    }

    stage('Déploiement sur S3') {
      steps {
        dir("${env.PROJECT_DIR}") {
          script {
            def bucket = sh(script: 'terraform -chdir=infra output -raw bucket_name', returnStdout: true).trim()
            def distId = sh(script: 'terraform -chdir=infra output -raw distribution_id', returnStdout: true).trim()
            sh "aws s3 sync app/dist s3://${bucket} --delete"
            sh "aws cloudfront create-invalidation --distribution-id ${distId} --paths '/*'"
          }
        }
      }
    }
  }

  post {
    success { echo 'Déploiement réussi !' }
    failure { echo 'Le pipeline a échoué : regarde le stage en rouge.' }
  }
}